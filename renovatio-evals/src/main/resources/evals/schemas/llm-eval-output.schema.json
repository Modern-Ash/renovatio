{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renovatio.llm-eval-output.v1",
  "title": "Renovatio LLM evaluation output",
  "type": "object",
  "required": ["schemaVersion", "prompt", "decisions", "rubricScores", "metrics"],
  "properties": {
    "schemaVersion": { "const": "renovatio.llm-eval-output.v1" },
    "prompt": { "type": "string" },
    "decisions": { "type": "array", "minItems": 1 },
    "rubricScores": { "type": "object" },
    "metrics": { "type": "object" }
  }
}
