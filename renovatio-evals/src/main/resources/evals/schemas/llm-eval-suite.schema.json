{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renovatio.llm-eval-suite.v1",
  "title": "Renovatio LLM evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "id", "prompt", "model", "cases"],
  "properties": {
    "schemaVersion": { "const": "renovatio.llm-eval-suite.v1" },
    "id": { "type": "string" },
    "prompt": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "model": { "type": "string" },
    "cases": { "type": "array", "minItems": 1 }
  }
}
