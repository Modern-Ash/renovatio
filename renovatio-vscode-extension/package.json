{
  "name": "renovatio-vscode-extension",
  "displayName": "Renovatio Modernization",
  "description": "Native VS Code integration for Renovatio COBOL modernization workflows.",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "publisher": "modern-ash",
  "repository": {
    "type": "git",
    "url": "https://github.com/Modern-Ash/renovatio.git",
    "directory": "renovatio-vscode-extension"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.cbl",
    "workspaceContains:**/*.cob",
    "workspaceContains:**/*.cpy",
    "workspaceContains:**/*.jcl",
    "workspaceContains:.renovatio/workspace.renovatio.json",
    "onCommand:renovatio.openWelcome",
    "onCommand:renovatio.initializeWorkspace",
    "onCommand:renovatio.openWorkspaceManifest",
    "onCommand:renovatio.validateWorkspace",
    "onCommand:renovatio.formatArtifacts",
    "onCommand:renovatio.createMigrationMap",
    "onCommand:renovatio.openMigrationMap",
    "onCommand:renovatio.validateMigrationMap",
    "onCommand:renovatio.formatMigrationMap",
    "onCommand:renovatio.openBackendSettings",
    "onCommand:renovatio.testBackendConnection",
    "onCommand:renovatio.openBackendLogs",
    "onCommand:renovatio.startBackend",
    "onCommand:renovatio.stopBackend",
    "onCommand:renovatio.restartBackend",
    "onCommand:renovatio.reloadBackendConfiguration",
    "onCommand:renovatio.configureLlmModel",
    "onCommand:renovatio.testLlmReverseEngineering",
    "onCommand:renovatio.clearLlmCache",
    "onCommand:renovatio.openPromptProfile",
    "onCommand:renovatio.compareLlmOutputAgainstGoldenFixture",
    "onCommand:renovatio.selectProject",
    "onCommand:renovatio.createProject",
    "onCommand:renovatio.analyzeSelectedPath",
    "onCommand:renovatio.analyzeCobolSources",
    "onCommand:renovatio.addCobolSourceRoot",
    "onCommand:renovatio.removeCobolSourceRoot",
    "onCommand:renovatio.selectGeneratedOutputFolder",
    "onCommand:renovatio.openControlDeck",
    "onCommand:renovatio.openPersistenceModel",
    "onCommand:renovatio.openGeneratedCode",
    "onCommand:renovatio.openDiscoveryOutput",
    "onCommand:renovatio.generateMigrationPlan",
    "onCommand:renovatio.previewMigrationDiff",
    "onCommand:renovatio.applyApprovedChanges",
    "onCommand:renovatio.reconcileGeneratedCode",
    "onCommand:renovatio.exportEvidenceBundle",
    "onCommand:renovatio.openDomainSample",
    "onCommand:renovatio.openArchitectureSample",
    "onCustomEditor:renovatio.diagram.domain",
    "onCustomEditor:renovatio.diagram.architecture",
    "onView:renovatio.workspace",
    "onView:renovatio.discovery",
    "onView:renovatio.models",
    "onView:renovatio.migration",
    "onView:renovatio.evidence",
    "onView:renovatio.backend",
    "onCommand:renovatio.openNativeDomainDiagram",
    "onCommand:renovatio.openNativePersistenceDiagram",
    "onCommand:renovatio.openNativeArchitectureDiagram"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Renovatio",
      "properties": {
        "renovatio.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8081",
          "description": "Renovatio API base URL."
        },
        "renovatio.role": {
          "type": "string",
          "default": "ADMIN",
          "description": "Role header sent to the Renovatio API during local development."
        },
        "renovatio.cobolRoots": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "description": "COBOL source roots analyzed by Renovatio. Relative paths are resolved from the VS Code workspace folder."
        },
        "renovatio.generatedRoot": {
          "type": "string",
          "default": "generated/java",
          "scope": "resource",
          "description": "Future target-code output root used after discovery, decisions, and approval. Relative paths are resolved from the VS Code workspace folder."
        },
        "renovatio.generatedRoots": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "description": "Future target-code output roots associated with this Renovatio VS Code workspace. The first root is used for analyzer output."
        },
        "renovatio.targetLanguage": {
          "type": "string",
          "default": "java",
          "scope": "resource",
          "enum": [
            "java",
            "python",
            "node"
          ],
          "description": "Modernization target language used later for approved emission planning."
        },
        "renovatio.targetPackage": {
          "type": "string",
          "default": "com.example.modernized",
          "scope": "resource",
          "description": "Default package/module namespace for later target-code emission."
        }
      }
    },
    "commands": [
      {
        "command": "renovatio.openWelcome",
        "title": "Renovatio: Welcome",
        "icon": "$(home)"
      },
      {
        "command": "renovatio.refresh",
        "title": "Renovatio: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "renovatio.initializeWorkspace",
        "title": "Renovatio: Initialize Workspace",
        "icon": "$(new-folder)"
      },
      {
        "command": "renovatio.openWorkspaceManifest",
