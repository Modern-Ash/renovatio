    "viewsContainers": {
      "activitybar": [
        {
          "id": "renovatio",
          "title": "Renovatio",
          "icon": "resources/renovatio-icon-master.png"
        }
      ]
    },
    "views": {
      "renovatio": [
        {
          "id": "renovatio.workspace",
          "name": "Workspace"
        },
        {
          "id": "renovatio.discovery",
          "name": "Discovery"
        },
        {
          "id": "renovatio.models",
          "name": "Models"
        },
        {
          "id": "renovatio.migration",
          "name": "Migration"
        },
        {
          "id": "renovatio.evidence",
          "name": "Evidence"
        },
        {
          "id": "renovatio.backend",
          "name": "Backend"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "renovatio.workspace",
        "contents": "Set up the local Renovatio workspace contract before analysis.\n[Initialize Workspace](command:renovatio.initializeWorkspace)\n[Open Manifest](command:renovatio.openWorkspaceManifest)\n[Validate Workspace](command:renovatio.validateWorkspace)\n[Add Source Root](command:renovatio.addCobolSourceRoot)\n[Configure Target Root](command:renovatio.selectGeneratedOutputFolder)"
      },
      {
        "view": "renovatio.discovery",
        "contents": "Discover COBOL, JCL, copybooks, datasets and warnings from the configured roots.\n[Analyze Workspace](command:renovatio.analyzeWorkspace)\n[Analyze Explorer Selection](command:renovatio.analyzeSelectedPath)\n[Open Discovery Output](command:renovatio.openDiscoveryOutput)"
      },
      {
        "view": "renovatio.models",
        "contents": "Inspect domain, persistence and architecture models after discovery.\n[Analyze Workspace](command:renovatio.analyzeWorkspace)\n[Open Domain Model](command:renovatio.openDomainModel)\n[Open Persistence Model](command:renovatio.openPersistenceModel)\n[Open Domain Diagram](command:renovatio.openNativeDomainDiagram)\n[Open Architecture Diagram](command:renovatio.openNativeArchitectureDiagram)"
      },
      {
        "view": "renovatio.migration",
        "contents": "Trace legacy source to target code and prepare approval-gated changes.\n[Create Migration Map](command:renovatio.createMigrationMap)\n[Open Migration Map](command:renovatio.openMigrationMap)\n[Validate Migration Map](command:renovatio.validateMigrationMap)\n[Preview Diff](command:renovatio.previewMigrationDiff)\n[Open Future Output](command:renovatio.openGeneratedCode)"
      },
      {
        "view": "renovatio.evidence",
        "contents": "Review analysis evidence, reports, risks and bundle export readiness.\n[Analyze Workspace](command:renovatio.analyzeWorkspace)\n[Open Control Deck](command:renovatio.openControlDeck)\n[Open Discovery Output](command:renovatio.openDiscoveryOutput)\n[Export Evidence Bundle](command:renovatio.exportEvidenceBundle)"
      },
      {
        "view": "renovatio.backend",
        "contents": "Configure Renovatio backend and LLM reverse-engineering from the local workspace manifest.\n[Initialize Workspace](command:renovatio.initializeWorkspace)\n[Test Backend Connection](command:renovatio.testBackendConnection)\n[Open Backend Settings](command:renovatio.openBackendSettings)\n[Open Backend Logs](command:renovatio.openBackendLogs)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "/.renovatio/workspace.renovatio.json",
          "workspace.renovatio.json"
        ],
        "url": "./schemas/workspace-manifest.schema.json"
      },
      {
        "fileMatch": [
          "*.renovatio-domain.json"
        ],
        "url": "./schemas/domain-model.schema.json"
      },
      {
        "fileMatch": [
          "*.renovatio-arch.json"
        ],
        "url": "./schemas/architecture.schema.json"
      },
      {
