        "icon": "$(pass)"
      },
      {
        "command": "renovatio.reconcileGeneratedCode",
        "title": "Renovatio: Reconcile Generated Code",
        "icon": "$(sync)"
      },
      {
        "command": "renovatio.exportEvidenceBundle",
        "title": "Renovatio: Export Evidence Bundle",
        "icon": "$(package)"
      },
      {
        "command": "renovatio.openDomainSample",
        "title": "Renovatio: Open Domain Diagram Sample",
        "category": "Renovatio"
      },
      {
        "command": "renovatio.openArchitectureSample",
        "title": "Renovatio: Open Architecture Diagram Sample",
        "category": "Renovatio"
      },
      {
        "command": "renovatio.openNativeDomainDiagram",
        "title": "Renovatio: Open Native Domain Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "renovatio.openNativePersistenceDiagram",
        "title": "Renovatio: Open Native Persistence Diagram",
        "icon": "$(database)"
      },
      {
        "command": "renovatio.openNativeArchitectureDiagram",
        "title": "Renovatio: Open Native Architecture Diagram",
        "icon": "$(circuit-board)"
      }
    ],
