        "icon": "$(beaker)"
      },
      {
        "command": "renovatio.clearLlmCache",
        "title": "Renovatio: Clear LLM Cache",
        "icon": "$(clear-all)"
      },
      {
        "command": "renovatio.openPromptProfile",
