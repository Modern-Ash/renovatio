        "icon": "$(json)"
      },
      {
        "command": "renovatio.validateWorkspace",
        "title": "Renovatio: Validate Workspace",
        "icon": "$(checklist)"
      },
      {
        "command": "renovatio.formatArtifacts",
        "title": "Renovatio: Format Artifacts",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "renovatio.createMigrationMap",
        "title": "Renovatio: Create Migration Map",
        "icon": "$(git-compare)"
      },
      {
        "command": "renovatio.openMigrationMap",
        "title": "Renovatio: Open Migration Map",
        "icon": "$(references)"
      },
      {
        "command": "renovatio.validateMigrationMap",
        "title": "Renovatio: Validate Migration Map",
        "icon": "$(checklist)"
      },
      {
