      "view/title": [
        {
          "command": "renovatio.refresh",
          "when": "view == renovatio.workspace || view == renovatio.discovery || view == renovatio.models || view == renovatio.migration || view == renovatio.evidence",
          "group": "navigation@1"
        },
        {
          "command": "renovatio.initializeWorkspace",
