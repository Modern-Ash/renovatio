{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ash.github.io/renovatio/schemas/architecture.schema.json",
  "title": "Renovatio Architecture Diagram",
  "description": "Permissive schema for Renovatio architecture diagrams managed by the VS Code custom editor.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layout": {
          "type": "object"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
