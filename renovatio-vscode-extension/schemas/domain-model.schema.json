{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ash.github.io/renovatio/schemas/domain-model.schema.json",
  "title": "Renovatio Domain Diagram",
  "description": "Permissive schema for Renovatio domain and persistence diagrams managed by the VS Code custom editor.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "layout": {
      "type": "object"
    },
    "excludedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
