{
  "name": "@renovatio/core-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "theia-extension",
    "renovatio"
  ],
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/browser/renovatio-core-ui-frontend-module"
    }
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@theia/core": "1.75.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3"
  }
}
