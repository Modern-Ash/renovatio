from decimal import Decimal
import re


def _coerce_value(value, picture):
    """Preserve the decimal scale declared by a COBOL PIC clause."""
    if value is None:
        return None
    scale_match = re.search(r"V(?:9\((\d+)\)|(\d+))", picture or "", re.IGNORECASE)
    if not scale_match:
        return value
    scale = int(scale_match.group(1)) if scale_match.group(1) else len(scale_match.group(2))
    quantum = Decimal(1).scaleb(-scale)
    return Decimal(str(value)).quantize(quantum)


