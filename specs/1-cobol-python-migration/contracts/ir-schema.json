{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COBOL IR Schema",
  "type": "object",
  "properties": {
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "picture": { "type": "string" },
                "type": { "type": "string" },
                "offset": { "type": "integer" },
                "length": { "type": "integer" },
                "scale": { "type": "integer" },
                "redefines": { "type": ["string", "null"] }
              },
              "required": ["name"]
            }
          },
          "procedures": {
            "type": "array",
            "items": { "type": "object" }
          },
          "io_definitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "record_layout": { "type": "array" }
              }
            }
          }
        },
        "required": ["name"]
      }
    }
  },
  "additionalProperties": false
}

